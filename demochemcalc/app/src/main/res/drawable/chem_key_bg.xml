<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- состояние нажатия -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chem_key_bg_dark" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/chem_border"/>
        </shape>
    </item>

    <!-- обычное состояние -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chem_key_bg" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/chem_border"/>
            <padding android:left="6dp" android:right="6dp"
                android:top="6dp" android:bottom="6dp"/>
        </shape>
    </item>

</selector>
